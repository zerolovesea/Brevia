def connect_key
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key_content: ENV.fetch('ASC_KEY_P8_BASE64'),
    is_key_content_base64: true
  )
end

lane :beta do
  encryption = ENV.fetch('IOS_USES_NON_EXEMPT_ENCRYPTION', '')
  UI.user_error!('Review the Apple encryption questionnaire for the current implementation, then set IOS_USES_NON_EXEMPT_ENCRYPTION to true or false') unless
    %w[true false].include?(encryption)
  upload_to_testflight(
    api_key: connect_key,
    app_identifier: 'com.brevia.breviaMobile',
    ipa: File.expand_path('../build/ios/ipa/Brevia.ipa', __dir__),
    groups: ['Brevia 内部测试'],
    distribute_external: false,
    submit_beta_review: false,
    skip_waiting_for_build_processing: false,
    wait_processing_timeout_duration: 2400,
    # 只使用维护者按当前实现复核问卷后的明确声明，不推定豁免。
    uses_non_exempt_encryption: encryption == 'true',
    changelog: ENV.fetch('TESTFLIGHT_CHANGELOG') { "内部测试 #{ENV.fetch('BUILD_NUMBER')} · #{ENV.fetch('GITHUB_SHA')[0, 7]}。统一手机与桌面的说话人文案，已有笔记默认渲染 Markdown，修正首页搜索与新建录音按钮靠右对齐。网络请求和数据协议未变更。" }
  )
end

# Promote an already tested binary. Store metadata/compliance must be completed in App Store Connect.
lane :promote do
  version = ENV.fetch('RELEASE_VERSION')
  build = ENV.fetch('RELEASE_BUILD')
  UI.user_error!('Use a version such as 1.0.0 and a numeric TestFlight build number') unless
    version.match?(/\A\d+\.\d+\.\d+\z/) && build.match?(/\A[1-9]\d*\z/)
  upload_to_app_store(
    api_key: connect_key,
    app_identifier: 'com.brevia.breviaMobile',
    app_version: version,
    build_number: build,
    skip_binary_upload: true,
    skip_metadata: false,
    skip_screenshots: true,
    submit_for_review: true,
    automatic_release: false,
    precheck_include_in_app_purchases: false,
    force: true
  )
end

# 只读回读版本、商店资料和正式审核记录，不输出密钥或审核联系人。
lane :store_status do
  connect_key
  app = Spaceship::ConnectAPI::App.find('com.brevia.breviaMobile')
  UI.user_error!('App unavailable') unless app
  versions = app.get_app_store_versions(filter: { platform: 'IOS' }, includes: 'appStoreVersionSubmission,build,appStoreReviewDetail', limit: 10)
  result = {
    versions: versions.map do |version|
      review = version.app_store_review_detail
      {
        version: version.version_string, state: version.app_store_state,
        build: version.get_build&.version, release: version.release_type,
        copyright: version.copyright,
        contact_complete: review && [review.contact_first_name, review.contact_last_name, review.contact_phone, review.contact_email].all? { |value| !value.to_s.empty? },
        login_required: review&.demo_account_required,
        review_notes_present: !review&.notes.to_s.empty?,
        locales: version.get_app_store_version_localizations.map do |locale|
          {
            locale: locale.locale, description_present: !locale.description.to_s.empty?,
            support_url: locale.support_url, whats_new: locale.whats_new,
            screenshots: locale.get_app_screenshot_sets.map do |set|
              { display: set.screenshot_display_type, states: (set.app_screenshots || []).map(&:asset_delivery_state) }
            end
          }
        end
      }
    end,
    submissions: app.get_review_submissions(includes: 'appStoreVersionForReview').map do |submission|
      { id: submission.id, state: submission.state, submitted_at: submission.submitted_date,
        version: submission.app_store_version_for_review&.version_string }
    end
  }
  puts "APP_STORE_STATUS=#{JSON.generate(result)}"
end
