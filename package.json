{
  "name": "brevia",
  "version": "1.4.5",
  "main": "electron/main.js",
  "scripts": {
    "assets:brand": "electron scripts/generate-brand-assets.cjs",
    "assets:brand:check": "electron scripts/generate-brand-assets.cjs --check",
    "build": "cd frontend && npx @tailwindcss/cli -i ./tailwind.css -o ./styles.css --minify",
    "start": "node scripts/start.cjs",
    "start:fresh": "node scripts/start.cjs --reset-onboarding",
    "test": "npm run test:dead && npm run test:electron && npm run test:ui && npm run test:e2e && npm run test:backend && npm run test:agent && npm run test:release",
    "test:dead": "node scripts/check_dead_code.mjs",
    "test:electron": "node electron/test-main-logic.mjs && node electron/test-desktop-controller.cjs && node scripts/test-deduplicate-runtime.cjs && node electron/test-mobile-server.cjs",
    "test:ui": "cd frontend && node ./test-ui.mjs && node ../scripts/test-motion.mjs && node ../scripts/test-desktop-mobile-preview.mjs",
    "test:backend": "node scripts/test-backend.cjs",
    "test:model": ".venv/bin/python -m backend.diagnose_model --models-dir .models",
    "test:diarization": ".venv/bin/python -m backend.diagnose_diarization --models-dir .models --download",
    "bench:electron": "electron . --bench-refinement",
    "pack:backend": "python backend/pack_worker.py && python backend/pack_llama_sidecar.py",
    "dist": "npm run dist:mac",
    "package:mac": "npm run package:mac:webkit",
    "package:win": "python backend/preflight_package.py && npm run build && node scripts/package-agent.cjs && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run dist:mac:webkit",
    "dist:win": "npm run pack:backend && npm run package:win",
    "release:offline": "node scripts/release-offline.cjs",
    "bench:live": ".venv/bin/python backend/bench_live.py",
    "test:e2e": "node electron/test-e2e.mjs",
    "css:fingerprint": "node scripts/verify-css-tokens.mjs",
    "clean": "node scripts/clean-build.mjs",
    "clean:dist": "node scripts/clean-build.mjs dist",
    "format": "prettier --write \"{electron,frontend,website,scripts}/**/*.{js,mjs,cjs,css,html}\" \"macos/{*.{js,cjs},*/*.cjs}\" \"*.{json,md,yml,yaml}\" \".github/workflows/*.{yml,yaml}\" \"docs/**/*.md\" \"mobile/*.{md,yaml}\" \"backend/*.md\"",
    "format:check": "prettier --check \"{electron,frontend,website,scripts}/**/*.{js,mjs,cjs,css,html}\" \"macos/{*.{js,cjs},*/*.cjs}\" \"*.{json,md,yml,yaml}\" \".github/workflows/*.{yml,yaml}\" \"docs/**/*.md\" \"mobile/*.{md,yaml}\" \"backend/*.md\"",
    "format:python": "python -m ruff format .",
    "lint:python": "python -m ruff check . && python -m ruff format --check .",
    "dist:mac:webkit": "node macos/runtime/package.cjs",
    "package:mac:webkit": "node macos/runtime/package.cjs app",
    "test:mac:webkit": "bash macos/check.sh",
    "start:electron": "electron .",
    "test:backend:legacy": "node scripts/test-backend.cjs --legacy",
    "brevia": "node scripts/brevia.cjs",
    "test:agent": "node --test electron/test-agent*.cjs macos/backend/test-agent*.cjs",
    "test:release": "node --test scripts/test-release.cjs"
  },
  "build": {
    "afterPack": "scripts/deduplicate-runtime.cjs",
    "appId": "com.brevia.app",
    "productName": "Brevia",
    "files": [
      "electron/**/*",
      "!electron/test-*.mjs",
      "package.json",
      "!electron/test-*.cjs"
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!*.pyc",
          "!.pytest_cache/**",
          "!build/**",
          "!test_*.py",
          "!diagnose_*.py",
          "!bench_*.py",
          "!benchmarks/**",
          "!*.spec",
          "!brevia-worker",
          "!brevia-worker.exe"
        ]
      },
      {
        "from": "frontend",
        "to": "frontend",
        "filter": [
          "**/*",
          "!test-*.mjs",
          "!tailwind.css"
        ]
      },
      {
        "from": "dist/agent/brevia.cjs",
        "to": "control/brevia.cjs"
      },
      {
        "from": "skills/brevia",
        "to": "skills/brevia"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "zerolovesea",
        "repo": "Brevia"
      }
    ],
    "win": {
      "compression": "maximum",
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "extraFiles": [
      {
        "from": "dist/agent/brevia.cmd",
        "to": "brevia.cmd"
      }
    ],
    "electronFuses": {
      "runAsNode": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Private, local-first meeting memory.",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^43.8.1",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher": "2.6.0"
    },
    "@electron/get@3.1.0": {
      "global-agent": "4.1.3"
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "bonjour-service": "^1.4.4",
    "electron-updater": "6.8.9",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "tar": "7.5.22",
    "zod": "^4.6.6"
  }
}
