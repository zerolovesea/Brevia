{
  "name": "brevia",
  "version": "1.1.3",
  "main": "electron/main.js",
  "scripts": {
    "build": "cd frontend && npx @tailwindcss/cli -i ./tailwind.css -o ./styles.css --minify",
    "start": "electron .",
    "start:fresh": "electron . --reset-onboarding",
    "test": "npm run test:electron && npm run test:ui && npm run test:backend",
    "test:electron": "node electron/test-main-logic.mjs",
    "test:ui": "cd frontend && node ./test-ui.mjs",
    "test:backend": "python -m unittest backend.test_worker",
    "test:model": ".venv/bin/python -m backend.diagnose_model --models-dir .models",
    "test:diarization": ".venv/bin/python -m backend.diagnose_diarization --models-dir .models --download",
    "pack:backend": "python backend/pack_worker.py && python backend/pack_llama_sidecar.py",
    "dist": "npm run dist:mac",
    "package:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run pack:backend && npm run package:mac",
    "dist:win": "npm run pack:backend && npm run package:win",
    "release:offline": "npm run build && npm run pack:backend && env -u APPLE_ID -u APPLE_APP_SPECIFIC_PASSWORD -u APPLE_TEAM_ID electron-builder --mac dmg --arm64 --publish never && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.brevia.app",
    "productName": "Brevia",
    "files": [
      "electron/**/*",
      "!electron/test-*.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!*.pyc",
          "!build/**",
          "!test_*.py",
          "!diagnose_*.py",
          "!*.spec",
          "!brevia-worker",
          "!brevia-worker.exe"
        ]
      },
      {
        "from": "frontend",
        "to": "frontend"
      }
    ],
    "mac": {
      "icon": "electron/assets/icon.icns",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Brevia captures system audio to transcribe meetings locally.",
        "NSMicrophoneUsageDescription": "Brevia captures microphone audio to transcribe meetings locally."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "YANG ZHOU (4M64879BBM)",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zerolovesea",
        "repo": "Brevia"
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-x64-setup.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Private, local-first meeting memory.",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "electron-updater": "6.8.9",
    "zod": "^4.4.3"
  }
}
